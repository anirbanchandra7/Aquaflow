# Google service account credentials JSON, as a single-line string.
# Alternatively set GOOGLE_SHEETS_CREDENTIALS_FILE to a path of the JSON file.
GOOGLE_SHEETS_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# The ID of the Google Spreadsheet that acts as the database
SPREADSHEET_ID=your-spreadsheet-id

# Secret used to sign JWTs
JWT_SECRET=change-me-to-a-long-random-string

# Super admin login (platform owner — not stored in the spreadsheet)
SUPER_ADMIN_EMAIL=admin@aquaflow.ae
SUPER_ADMIN_PASSWORD=change-me

# Server port (optional, defaults to 4000)
PORT=4000

# Frontend origin allowed for CORS (cookie auth requires an exact origin)
CLIENT_ORIGIN=http://localhost:5173
